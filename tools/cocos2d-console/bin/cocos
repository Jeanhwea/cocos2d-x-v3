#!/bin/bash -l

COCOS_CONSOLE_BIN_DIRECTORY=$(dirname "$0")
COCOS_CONSOLE_BIN_DIRECTORY=$(cd "$COCOS_CONSOLE_BIN_DIRECTORY" && pwd -P)


if hash python3 2>/dev/null; then
    PYTHON=python3
elif hash python2 2>/dev/null; then
    PYTHON=python2
elif hash python 2>/dev/null; then
    PYTHON=python
else
    echo "Python required (python3, python2, or python not found)."
    exit 1
fi

$PYTHON "$COCOS_CONSOLE_BIN_DIRECTORY/cocos.py" "$@"

